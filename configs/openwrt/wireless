# OpenWrt UCI batch overlay. This is not a complete /etc/config/wireless file.
# Keys are injected by router-config.sh and never stored in this fragment.

delete wireless.pixelmain
set wireless.pixelmain='wifi-iface'
set wireless.pixelmain.device='radio0'
set wireless.pixelmain.mode='ap'
set wireless.pixelmain.network='pixelmain'
set wireless.pixelmain.ssid='PixelMain'
set wireless.pixelmain.encryption='sae'

