# Feature overlay: adblock-fast policy and the complete source allowlist.

set adblock-fast.config.enabled='1'
set adblock-fast.config.dns='dnsmasq.servers'
set adblock-fast.config.dnsmasq_validity_check='1'
delete adblock-fast.config.dnsmasq_config_file_url
set adblock-fast.config.config_update_enabled='0'
set adblock-fast.config.force_dns='1'
delete adblock-fast.config.force_dns_interface
add_list adblock-fast.config.force_dns_interface='pixel'
add_list adblock-fast.config.force_dns_interface='pixelthings'
add_list adblock-fast.config.force_dns_interface='pixelguest'
add_list adblock-fast.config.force_dns_interface='pixeliot'
delete adblock-fast.config.force_dns_port
add_list adblock-fast.config.force_dns_port='53'
add_list adblock-fast.config.force_dns_port='853'
set adblock-fast.config.download_allow_insecure='0'
set adblock-fast.config.allow_non_ascii='0'

