# Feature overlay: adblock-fast policy and project-owned sources.

set adblock-fast.config.enabled='1'
set adblock-fast.config.dns='dnsmasq.servers'
set adblock-fast.config.force_dns='1'
delete adblock-fast.config.force_dns_interface
add_list adblock-fast.config.force_dns_interface='pixelmain'
add_list adblock-fast.config.force_dns_interface='pixelsecondary'
add_list adblock-fast.config.force_dns_interface='pixelguest'
add_list adblock-fast.config.force_dns_interface='pixeliot'
delete adblock-fast.config.force_dns_port
add_list adblock-fast.config.force_dns_port='53'
add_list adblock-fast.config.force_dns_port='853'
set adblock-fast.config.download_allow_insecure='0'
set adblock-fast.config.allow_non_ascii='0'

delete adblock-fast.adguard_general
set adblock-fast.adguard_general='file_url'
set adblock-fast.adguard_general.name='AdGuard general'
set adblock-fast.adguard_general.url='https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt'
set adblock-fast.adguard_general.action='block'
set adblock-fast.adguard_general.enabled='1'
delete adblock-fast.hagezi_pro
set adblock-fast.hagezi_pro='file_url'
set adblock-fast.hagezi_pro.name='Hagezi Pro'
set adblock-fast.hagezi_pro.url='https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/pro-onlydomains.txt'
set adblock-fast.hagezi_pro.action='block'
set adblock-fast.hagezi_pro.enabled='1'
delete adblock-fast.adguard_cname_trackers
set adblock-fast.adguard_cname_trackers='file_url'
set adblock-fast.adguard_cname_trackers.name='AdGuard CNAME trackers'
set adblock-fast.adguard_cname_trackers.url='https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_disguised_trackers_justdomains.txt'
set adblock-fast.adguard_cname_trackers.action='block'
set adblock-fast.adguard_cname_trackers.enabled='1'
delete adblock-fast.cert_polska
set adblock-fast.cert_polska='file_url'
set adblock-fast.cert_polska.name='CERT Polska'
set adblock-fast.cert_polska.url='https://hole.cert.pl/domains/v2/domains.txt'
set adblock-fast.cert_polska.action='block'
set adblock-fast.cert_polska.enabled='1'
