# Feature overlay: DoH upstreams, NTP bootstrap, and encrypted-DNS policy.

set https-dns-proxy.config='main'
set https-dns-proxy.config.dnsmasq_config_update='-'
set https-dns-proxy.config.force_dns='0'
set https-dns-proxy.config.notrack_dns='0'

set https-dns-proxy.quad9='https-dns-proxy'
set https-dns-proxy.quad9.resolver_url='https://dns.quad9.net/dns-query'
set https-dns-proxy.quad9.listen_port='5053'
set https-dns-proxy.quad9.bootstrap_dns='9.9.9.11,1.1.1.1,8.8.8.8'
set https-dns-proxy.cloudflare_security='https-dns-proxy'
set https-dns-proxy.cloudflare_security.resolver_url='https://security.cloudflare-dns.com/dns-query'
set https-dns-proxy.cloudflare_security.listen_port='5054'
set https-dns-proxy.cloudflare_security.bootstrap_dns='9.9.9.11,1.1.1.1,8.8.8.8'
set https-dns-proxy.control_d_ads_tracking='https-dns-proxy'
set https-dns-proxy.control_d_ads_tracking.resolver_url='https://freedns.controld.com/p2'
set https-dns-proxy.control_d_ads_tracking.listen_port='5055'
set https-dns-proxy.control_d_ads_tracking.bootstrap_dns='9.9.9.11,1.1.1.1,8.8.8.8'
set https-dns-proxy.mullvad_base='https-dns-proxy'
set https-dns-proxy.mullvad_base.resolver_url='https://base.dns.mullvad.net/dns-query'
set https-dns-proxy.mullvad_base.listen_port='5056'
set https-dns-proxy.mullvad_base.bootstrap_dns='9.9.9.11,1.1.1.1,8.8.8.8'

set dhcp.dnsmasq.noresolv='1'
set dhcp.dnsmasq.cachesize='4096'
delete dhcp.dnsmasq.server
add_list dhcp.dnsmasq.server='127.0.0.1#5053'
add_list dhcp.dnsmasq.server='127.0.0.1#5054'
add_list dhcp.dnsmasq.server='127.0.0.1#5055'
add_list dhcp.dnsmasq.server='127.0.0.1#5056'

delete system.ntp.server
add_list system.ntp.server='194.177.4.1'
add_list system.ntp.server='213.222.217.11'
add_list system.ntp.server='80.50.102.114'
add_list system.ntp.server='193.219.28.60'

set network.wan.peerdns='0'

delete firewall.divert_dns_53
set firewall.divert_dns_53='redirect'
set firewall.divert_dns_53.name='Divert-DNS, port 53'
set firewall.divert_dns_53.src='wan'
set firewall.divert_dns_53.dest='lan'
set firewall.divert_dns_53.src_dport='53'
set firewall.divert_dns_53.dest_port='53'
set firewall.divert_dns_53.target='DNAT'
delete firewall.reject_dot_853
set firewall.reject_dot_853='rule'
set firewall.reject_dot_853.name='Reject-DoT, port 853'
set firewall.reject_dot_853.src='lan'
set firewall.reject_dot_853.dest='wan'
set firewall.reject_dot_853.dest_port='853'
set firewall.reject_dot_853.proto='tcp'
set firewall.reject_dot_853.target='REJECT'
delete firewall.divert_dns_5353
set firewall.divert_dns_5353='redirect'
set firewall.divert_dns_5353.name='Divert-DNS, port 5353'
set firewall.divert_dns_5353.src='lan'
set firewall.divert_dns_5353.dest='lan'
set firewall.divert_dns_5353.src_dport='5353'
set firewall.divert_dns_5353.dest_port='53'
set firewall.divert_dns_5353.target='DNAT'
