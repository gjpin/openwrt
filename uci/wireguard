# Feature template: non-secret values are rendered transaction-locally.
# Private and preshared keys are injected directly into the mode-0600 candidate.

delete network.${VPN_IF}
set network.${VPN_IF}='interface'
set network.${VPN_IF}.proto='wireguard'
set network.${VPN_IF}.listen_port='${VPN_PORT}'
add_list network.${VPN_IF}.addresses='${VPN_ADDR}'
add_list network.${VPN_IF}.addresses='${VPN_ADDR6}'
delete network.wgclient
set network.wgclient='wireguard_${VPN_IF}'
set network.wgclient.public_key='${VPN_PUB}'
add_list network.wgclient.allowed_ips='${VPN_CLIENT_ADDR}'
add_list network.wgclient.allowed_ips='${VPN_CLIENT_ADDR6}'

del_list firewall.pixelmain.network='${VPN_IF}'
add_list firewall.pixelmain.network='${VPN_IF}'
delete firewall.allow_wireguard
set firewall.allow_wireguard='rule'
set firewall.allow_wireguard.name='Allow-WireGuard'
set firewall.allow_wireguard.src='wan'
set firewall.allow_wireguard.dest_port='${VPN_PORT}'
set firewall.allow_wireguard.proto='udp'
set firewall.allow_wireguard.target='ACCEPT'
